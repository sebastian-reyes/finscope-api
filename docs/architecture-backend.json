  "cards": [
    {
      "dot": "cyan",
      "title": "Reactiva de arriba abajo",
      "items": [
        "WebFlux y R2DBC en lugar de MVC y JDBC",
        "Ninguna petición bloquea un hilo esperando a la base",
        "Lo que sí bloquea —BCrypt, SMTP— sale a boundedElastic"
      ]
    },
    {
      "dot": "emerald",
      "title": "El contrato manda",
      "items": [
        "El YAML no documenta la API: la define",
        "El generador rehace DTO e interfaces en cada compilación",
        "Una respuesta fuera del contrato no llega a compilar"
      ]
    },
    {
      "dot": "rose",
      "title": "Seguridad",
      "items": [
        "Cupo por origen antes de tocar la aplicación",
        "JWT HS256: emisor, destinatario, caducidad y sujeto",
        "El user_id sale del token; lo ajeno responde 404"
      ]
    },
    {
      "dot": "amber",
      "title": "Persistencia",
      "items": [
        "Trece tablas, todas colgando del usuario",
        "Flyway al arrancar, con el reverso escrito al lado",
        "Lo que se puede calcular no se guarda"
      ]
    }
  ]
