# Plantilla de variables de entorno de FinScope. Copiala a .env y rellena los valores.
#
#     cp .env.example .env
#
# .env esta ignorado por git y nunca debe subirse. Este archivo solo lleva los nombres:
# ningun valor de aqui es un secreto real ni debe usarse tal cual.
#
# Se lee en dos sitios distintos y solo en local:
#   - docker compose, que toma de aqui las credenciales de la base y los puertos publicados.
#   - el arranque desde el IDE o la linea de ordenes, si se exporta.
# En produccion no existe .env: las variables las define la plataforma (en Render, el panel
# de Environment del servicio), y lo que se despliega es la imagen, no este archivo.

# ===========================================================================
# COMUNES --- necesarias en cualquier entorno
# ===========================================================================

# dev para desarrollo local, prod para el contenedor y para el despliegue.
# El Dockerfile ya fija prod; esto solo manda al arrancar fuera del contenedor.
SPRING_PROFILES_ACTIVE=dev

# Base de datos, por piezas sueltas.
# Dentro de docker compose DB_HOST es el nombre del servicio (postgres), no localhost.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Clave de firma de los tokens. Minimo 32 bytes y distinta en cada entorno.
# Generar con: openssl rand -base64 48
JWT_SECRET=

# Origenes del navegador autorizados, separados por comas.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ===========================================================================
# DEV --- solo desarrollo local y docker compose
# ===========================================================================
# El perfil dev trae defecto para todo lo de arriba, asi que en local basta con rellenar
# lo que se quiera cambiar. docker compose es la excepcion: exige DB_PASSWORD y JWT_SECRET
# de forma explicita y no arranca sin ellos.

# La base local no habla TLS.
DB_SSL_MODE=disable

# Puertos que docker compose publica en el anfitrion. Solo sirven para asomarse desde
# fuera: entre contenedores el trafico va por la red interna.
DB_EXPOSED_PORT=5433
API_EXPOSED_PORT=9090

# Puerto en el que escucha la aplicacion al arrancarla a mano.
SERVER_PORT=8080

# ===========================================================================
# PROD --- despliegue (Render o equivalente)
# ===========================================================================
# En el perfil prod ninguna de estas tiene defecto: si falta una, la aplicacion no arranca.
# Obligatorias: DB_HOST, DB_NAME, DB_USERNAME, DB_PASSWORD, JWT_SECRET,
# CORS_ALLOWED_ORIGINS  (o bien DB_URL y DB_JDBC_URL en lugar de las piezas de la base).
#
# JWT_SECRET debe ser distinto del de desarrollo y no puede pasar nunca por el repositorio.
# CORS_ALLOWED_ORIGINS debe ser el dominio real del frontend, no localhost.

# Con un PostgreSQL administrado el cifrado de la conexion no es opcional.
# DB_SSL_MODE=require

# Alternativa a las piezas sueltas: las cadenas completas que entrega el proveedor.
# Si se rellenan, tienen prioridad sobre DB_HOST/DB_PORT/DB_NAME.
# DB_URL=r2dbc:postgresql://host:5432/base?sslMode=require
# DB_JDBC_URL=jdbc:postgresql://host:5432/base?sslmode=require

# Render inyecta PORT por su cuenta y la aplicacion lo prefiere sobre SERVER_PORT:
# no hay que definir ninguno de los dos alli.

# Detras del proxy inverso de la plataforma se confia en las cabeceras reenviadas, que es
# el valor por defecto. Solo hay que cambiarlo si no hay proxy delante.
# FORWARD_HEADERS_STRATEGY=framework
